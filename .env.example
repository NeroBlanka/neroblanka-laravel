APP_NAME=Neroblanka
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://neroblanka.com

APP_LOCALE=fr
APP_FALLBACK_LOCALE=fr
APP_FAKER_LOCALE=fr_FR

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error

DB_CONNECTION=pgsql
DB_HOST=
DB_PORT=5432
DB_DATABASE=neroblanka
DB_USERNAME=
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=neroblanka.com

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=s3
QUEUE_CONNECTION=database
# Worker : php artisan queue:work --queue=emails,ai,default --sleep=3 --tries=3

CACHE_STORE=database
CACHE_PREFIX=

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=resend
MAIL_FROM_ADDRESS=noreply@neroblanka.com
MAIL_FROM_NAME="${APP_NAME}"
RESEND_KEY=

# Cloudflare R2 — bucket privé (briefs, livrables) — clé API dans R2 > Manage API Tokens
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=auto
AWS_BUCKET=neroblanka
AWS_ENDPOINT=https://<account_id>.r2.cloudflarestorage.com
AWS_USE_PATH_STYLE_ENDPOINT=true

# Cloudflare R2 — bucket public (portfolio, images CDN) — peut utiliser les mêmes clés ou des clés dédiées
AWS_PUBLIC_ACCESS_KEY_ID=
AWS_PUBLIC_SECRET_ACCESS_KEY=
AWS_PUBLIC_DEFAULT_REGION=auto
AWS_PUBLIC_BUCKET=neroblanka-public
AWS_PUBLIC_URL=https://pub-<hash>.r2.dev
# AWS_PUBLIC_ENDPOINT= (même endpoint que le bucket privé si dans le même compte)

# OpenAI — analyse leads (queue:ai)
OPENAI_API_KEY=

# Sentry — error tracking (optionnel)
SENTRY_LARAVEL_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1

VITE_APP_NAME="${APP_NAME}"

# ─── Brief wizard — uploads volumineux (jusqu'à 400 Mo) ───────────────────
# Le wizard /brief accepte les fichiers jusqu'à 400 Mo (pdf/png/jpeg/zip/rar/mp4/mov/webm/mkv)
# et propose un lien Swisstransfer/WeTransfer pour les fichiers plus gros.
# Pour qu'un upload de 400 Mo passe réellement en prod, lever les limites :
#   php.ini    : upload_max_filesize = 400M, post_max_size = 420M, max_execution_time = 300
#   nginx      : client_max_body_size 420M; (vhost ou http block)
# Sans ces réglages, PHP rejette l'upload avant que Laravel valide.
